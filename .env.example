# ─────────────────────────────────────────────────────────────────────────────
# ARC Music — environment configuration
# Local development: copy to `.env.local` and fill in.
# GitHub Pages: set the same names as repository variables instead
# (Settings → Secrets and variables → Actions → Variables); the deploy
# workflow passes them to the build.
# Every VITE_* value is compiled into the public JavaScript bundle, so none of
# them may be a secret.
# ─────────────────────────────────────────────────────────────────────────────

# Spotify ────────────────────────────────────────────────────────────────────
# Client ID of your app at https://developer.spotify.com/dashboard
# (Authorization Code with PKCE — no client secret is used or needed.)
VITE_SPOTIFY_CLIENT_ID=

# Must match a Redirect URI registered on the Spotify app *exactly*.
# Spotify rejects `localhost`; use the loopback IP for local development.
# When empty, the app uses <the address it is served from>/callback — on
# GitHub Pages that is https://kingjnu-sakayume.github.io/player1/callback,
# so leave the repository variable unset there.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Deployment ─────────────────────────────────────────────────────────────────
# Public base path of the build. `/` for a domain root, `/player1/` for
# https://<owner>.github.io/player1/. The router and default redirect use it.
# The GitHub Pages workflow sets it from the Pages configuration.
VITE_BASE_PATH=/

# Lyrics ─────────────────────────────────────────────────────────────────────
# lrclib : public LRCLIB API (https://lrclib.net) — no key; sends track title,
#          artist, album and duration to lrclib.net.
# mock   : built-in non-copyright test lines for every track (development).
# none   : never fetch lyrics.
VITE_LYRICS_PROVIDER=lrclib

# Translation ────────────────────────────────────────────────────────────────
# browser : on-device Translator API built into recent Chromium browsers — no key.
# http    : POST to your own serverless endpoint (see README "Translation
#           providers"). Keep any DeepL/Papago/Google secret on that server.
# mock    : development dictionary for the built-in test lines.
# none    : translation row is never shown.
VITE_TRANSLATION_PROVIDER=browser
# Public URL of your translation function (only for `http`). Not a secret.
VITE_TRANSLATION_ENDPOINT=
# BCP 47 target language for lyric translation.
VITE_TRANSLATION_TARGET=ko

# Preview ────────────────────────────────────────────────────────────────────
# Offer a "Preview without Spotify" catalogue on the connect screen (seed data,
# simulated clock, no network). Set to false to hide it in production.
VITE_ENABLE_PREVIEW=true

# Never put Spotify client secrets or private provider keys in VITE_* variables.
# If a lyrics or translation provider needs a secret, proxy it through a secure
# backend/serverless function and point the app at that function instead.
